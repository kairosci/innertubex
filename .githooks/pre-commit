#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

printf '%s\n' 'Running InnerTubeX pre-commit checks...'
if ! ./gradlew ktlintCheck apiCheck --no-configuration-cache; then
    printf '%s\n' '' >&2
    printf '%s\n' 'Pre-commit checks failed.' >&2
    printf '%s\n' 'Run ./gradlew ktlintFormat to fix formatting.' >&2
    printf '%s\n' 'For an intentional public API change, run ./gradlew desktopApiDump and review the API diff.' >&2
    exit 1
fi
